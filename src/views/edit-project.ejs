<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= projectDetails.title %>" maxlength="100"
                    required />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required><%= projectDetails.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= projectDetails.location %>" maxlength="100"
                    required />
            </div>

            <div class="form-group">
                <label for="starting_date">Starting Date</label>
                <input type="date" id="starting_date" name="starting_date"
                    value="<%= new Date(projectDetails.starting_date).toISOString().split('T')[0] %>" required />
            </div>

            <div class="form-group">
                <label for="organization_id">Organization</label>
                <select id="organization_id" name="organization_id" required>
                    <% organizations.forEach((organization)=> { %>
                        <option value="<%= organization.organization_id %>"
                            <%=organization.organization_id===projectDetails.organization_id ? 'selected' : '' %>>
                            <%= organization.name %>
                        </option>
                        <% }) %>
                </select>
            </div>

            <button type="submit">Update Project</button>
        </form>

    </main>
    <%- include('partials/footer') %>