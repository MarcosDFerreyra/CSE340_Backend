<%- include('partials/header') %>
    <main>
        <h1> <%= title %> </h1>
        <h2> <%= project_details.title %> </h2>
        <p>Description: <%= project_details.description %></p>
        <p>Date: <%= new Date(project_details.starting_date).toLocaleDateString('en-US', 
            {year: 'numeric', 
            month: 'long',
            day: 'numeric'}) %></p>
        <p>location: <%= project_details.location%></p>
        <a href="/organization/<%= project_details.organization_id%>"><%= project_details.organization_name%></a>

        <h3>Categories</h3>
        <ul>
            <li> 
                <% categories.forEach(category=> { %>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a>
                    <% }) %>
            </li>
        </ul>
        <div>
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/assign-categories/<%= project_details.project_id %>">Assign Project Categories</a>
                <% } %>
        </div>

        <% if (user && user.role_name==='admin' ) { %>
            <a href="/edit-project/<%= project_details.project_id %>">Edit Project</a>
            <% } %>
    </main>
    <%- include('partials/footer') %>